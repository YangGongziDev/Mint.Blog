// 生产环境配置-会被appsettings.Development.json覆盖
{
  // ---- 必须手动自定义配置: 数据库 ----
  "PostgreSql": {
    // PostgreSQL 连接字符串
    // 格式: Host=主机/容器名;Port=端口;Database=库名;Username=用户名;Password=密码
    "ConnectionString": "Host=主机/容器名;Port=5432;Database=Mint.Blog;Username=postgres;Password=自己配置"
  },

  // ---- 必须手动自定义配置: RustFS 对象存储（图片/文件上传）----
  "RustFS": {
    // 后端访问 RustFS 服务地址/容器名
    "Endpoint": "http://主机或容器名:9000",
    // 后端访问 RustFS 时是否启用 SSL,建议不启用
    "UseSsl": false,
    // 前端访问图片时使用的公开地址
    "PublicEndpoint": "https://img.自己配置.dev",
    // RustFS AccessKey
    "AccessKey": "自己配置",
    // RustFS SecretKey
    "SecretKey": "自己配置",
    // 存储桶名称
    "BucketName": "blog-article"
  },

  // 日志配置
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          // 容器内写入 /app/logs，通过挂载保存到宿主机 /opt/mint-blog/logs
          "path": "logs/mint-blog-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "shared": true
        }
      }
    ]
  },

  // ---- JWT 认证 ----
  "Jwt": {
    // 签发者标识，一般不需要改
    "Issuer": "自己配置",
    // 接收者标识，一般不需要改
    "Audience": "自己配置",
    // JWT 签名密钥，请替换为至少 32 位的随机字符串
    // "SecurityKey": "请替换为至少32位以上的生产密钥",
    "SecurityKey": "自己配置",
    // AccessToken 过期时间（分钟）
    "AccessTokenExpireMinutes": 120
  },

  // ---- 邮件发送（SMTP）----
  "Smtp": {
    // SMTP 服务器地址，如 smtp.qq.com / smtp.163.com
    "Host": "smtp.qq.com",
    // SMTP 端口，QQ邮箱为 465（SSL）或 587（STARTTLS）
    "Port": 465,
    // SMTP 登录用户名（通常就是邮箱地址）
    "UserName": "请替换为你的邮箱@qq.com",
    // SMTP 登录密码（QQ邮箱需使用授权码，非登录密码）
    "Password": "请替换为QQ邮箱授权码",
    // 发件人邮箱地址
    "From": "请替换为你的邮箱@qq.com",
    // 是否启用 SSL
    "EnableSsl": true
  },

  "Site": {
    // 博客前台的可信绝对网址（不使用请求 Host）
    "Url": "https://www.自己配置.dev",
    // RSS 文章链接的可信绝对网址（不使用请求 Host）
    "FeedUrl": "https://www.yanggongzi.dev/api/rss"
  },

  // ---- 评论通知 ----
  "CommentNotification": {
    // 博客前台域名，用于生成评论通知中的文章链接
    // 格式: https://www.example.com/#
    "Domain": "https://www.自己配置.dev/#"
  },

  // 允许访问的主机名，* 表示不限制
  "AllowedHosts": "*"
}
