// 生产环境配置
{
  // ---- 必须配置: 数据库 ----
  "PostgreSql": {
    // PostgreSQL 连接字符串
    // 格式: Host=主机;Port=端口;Database=库名;Username=用户名;Password=密码
    // 本地开发时，此值会被 appsettings.Development.json 覆盖
    "ConnectionString": "Host=127.0.0.1;Port=5432;Database=Mint.Blog;Username=postgres;Password=mintblog"
  },

  // ---- 必须配置: MinIO 对象存储（图片/文件上传）----
  "Minio": {
    // MinIO 服务地址，含协议
    // 本地开发时，此值会被 appsettings.Development.json 覆盖为 http://127.0.0.1:9000
    "Endpoint": "https://img.example.cn",
    // 后端访问 MinIO 时是否启用 SSL
    "UseSsl": true,
    // 前端访问图片时使用的公开地址
    "PublicEndpoint": "https://img.example.cn",
    // MinIO AccessKey（控制台登录用户名）
    "AccessKey": "mintblog",
    // MinIO SecretKey（控制台登录密码）
    "SecretKey": "mintblog",
    // 存储桶名称
    "BucketName": "mintblog"
  },

  
  // 日志级别配置
  "Logging": {
    "LogLevel": {
      // 默认日志级别：Information / Warning / Error
      // 生产环境建议 Warning 以减少日志量
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  // ---- JWT 认证 ----
  "Jwt": {
    // 签发者标识，一般不需要改
    "Issuer": "Mint.Blog",
    // 接收者标识，一般不需要改
    "Audience": "Mint.Blog",
    // JWT 签名密钥，请替换为至少 32 位的随机字符串
    // 本地开发时，此值会被 appsettings.Development.json 覆盖
    // "SecurityKey": "请替换为至少32位以上的生产密钥",
    "SecurityKey": "mint-blog-production-secret-key-2026-hs256",
    // AccessToken 过期时间（分钟）
    "AccessTokenExpireMinutes": 120
  },

  // ---- 邮件发送（SMTP）----
  "Smtp": {
    // SMTP 服务器地址，如 smtp.qq.com / smtp.163.com
    "Host": "smtp.qq.com",
    // SMTP 端口，QQ邮箱为 465（SSL）或 587（STARTTLS）
    "Port": 465,
    // SMTP 登录用户名（通常就是邮箱地址）
    "UserName": "请替换为你的邮箱@qq.com",
    // SMTP 登录密码（QQ邮箱需使用授权码，非登录密码）
    "Password": "请替换为QQ邮箱授权码",
    // 发件人邮箱地址
    "From": "请替换为你的邮箱@qq.com",
    // 是否启用 SSL
    "EnableSsl": true
  },

  // ---- 评论通知 ----
  "CommentNotification": {
    // 博客前台域名，用于生成评论通知中的文章链接
    // 格式: https://www.example.com/#
    // 本地开发时，此值会被 appsettings.Development.json 覆盖为 http://127.0.0.1:5259/#
    "Domain": "https://www.example.cn/#"
  },

  // 允许访问的主机名，* 表示不限制
  "AllowedHosts": "*"
}
