// 开发环境配置-本地启动时同名配置会覆盖appsettings.json
{
  // ---- 必须手动自定义配置: 数据库 ----
  "PostgreSql": {
    // PostgreSQL 连接字符串（本地开发）
     "ConnectionString": "Host=localhost;Port=5432;Database=Mint.Blog;Username=postgres;Password=自己配置"
  },

  // ---- 必须手动自定义配置: RustFS 对象存储（图片/文件上传）----
  "RustFS": {
    // 后端访问 RustFS 服务地址/容器名
    "Endpoint": "http://127.0.0.1:9000",
    // 后端访问 RustFS 时是否启用 SSL,建议不启用
    "UseSsl": false,
    // 前端访问图片时使用的公开地址
    "PublicEndpoint": "http://127.0.0.1:9000",
    // RustFS AccessKey
    "AccessKey": "自己配置",
    // RustFS SecretKey
    "SecretKey": "自己配置",
    "BucketName": "blog-article"
  },

  // 日志配置
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          // 保存到进程当前工作目录下的 logs 目录 
          "path": "logs/mint-blog-development-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "shared": true
        }
      }
    ]
  },

  // ---- JWT 认证 ----
  "Jwt": {
    "Issuer": "自己配置",
    "Audience": "自己配置",
    // 开发环境 JWT 签名密钥，生产环境请使用不同的密钥
    "SecurityKey": "mint-blog-development-secret-key-2026-hs256",
    // AccessToken 过期时间（分钟），开发环境设长一点方便调试
    "AccessTokenExpireMinutes": 120
  },

  // ---- 邮件发送（SMTP）----
  "Smtp": {
    // SMTP 服务器地址
    "Host": "smtp.qq.com",
    "Port": 465,
    // 发件邮箱和授权码（QQ邮箱需使用授权码，非登录密码）
    "UserName": "",
    "Password": "",
    "From": "",
    "EnableSsl": true
  },

  // RSS 返回的内容会包含
  "Site": {
    // 前端网站根地址，用于生成 RSS 中的网站首页、文章详情等链接
    "Url": "http://localhost:7100",
    // RSS 接口自身的完整地址，用于生成`atom:link` ；开发环境还用于精确放行本站本地 RSS 解析
    "FeedUrl": "http://localhost:7000/api/rss"
  },

  // ---- 评论通知 ----
  "CommentNotification": {
    // 本地开发时的博客前台地址
    "Domain": "http://127.0.0.1:5259/#"
  },

  "AllowedHosts": "*"
}
