// 本地开发环境配置
{
  // ---- 必须配置: 数据库 ----
  "PostgreSql": {
    // PostgreSQL 连接字符串（本地开发）
    "ConnectionString": "Host=localhost;Port=5432;Database=Mint.Blog;Username=postgres;Password=mintblog"
  },

  // ---- MinIO 对象存储（本地开发）----
  "Minio": {
    // 本地 MinIO 服务地址
    "Endpoint": "http://127.0.0.1:9000",
    // 后端访问 MinIO 时是否启用 SSL
    "UseSsl": false,
    // 前端访问图片时使用的公开地址
    "PublicEndpoint": "http://127.0.0.1:9000",
    // MinIO 控制台用户名
    "AccessKey": "mintblog",
    // MinIO 控制台密码
    "SecretKey": "mintblog",
    "BucketName": "mintblog"
  },

  
  // 日志级别配置
  "Logging": {
    "LogLevel": {
      // 开发环境可设为 Information 或 Debug 查看更详细日志
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  // ---- JWT 认证 ----
  "Jwt": {
    "Issuer": "Mint.Blog",
    "Audience": "Mint.Blog",
    // 开发环境 JWT 签名密钥，生产环境请使用不同的密钥
    "SecurityKey": "mint-blog-development-secret-key-2026-hs256",
    // AccessToken 过期时间（分钟），开发环境设长一点方便调试
    "AccessTokenExpireMinutes": 120
  },

  // ---- 开发工具：打印密码哈希 ----
  // 开启后启动时会打印指定密码的 BCrypt 哈希到控制台，用于生成用户密码
  "DevPasswordTools": {
    // 要生成哈希的明文密码
    "PrintPassword": "VisitorAdmin",
    // 是否启用：true / false
    "Enabled": false
  },

  // ---- 邮件发送（SMTP）----
  "Smtp": {
    // SMTP 服务器地址
    "Host": "smtp.qq.com",
    "Port": 465,
    // 发件邮箱和授权码（QQ邮箱需使用授权码，非登录密码）
    "UserName": "",
    "Password": "",
    "From": "",
    "EnableSsl": true
  },

  // ---- 评论通知 ----
  "CommentNotification": {
    // 本地开发时的博客前台地址
    "Domain": "http://127.0.0.1:5259/#"
  },

  "AllowedHosts": "*"
}
