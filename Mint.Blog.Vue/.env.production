# 基础路径,默认使用根路径；如果部署到子目录，必须以 / 结尾 / Default is root path; if deployed to a subdirectory, it must end with /
VITE_BASE_URL=/

# 应用标题 / Application title
VITE_APP_TITLE=Mint.Blog

# 后端服务地址（生产环境） / Backend service base URL (production)
# 推荐配合 Nginx 同域反代使用：前端 https://www.example.com，后端接口 https://www.example.com/api/
# 如果使用独立 API 域名，可改为：https://api.example.com/api/
# 生产环境 API 地址：通过 Nginx 反向代理，写绝对路径 /api/ 即可
VITE_SERVICE_BASE_URL=/api/
